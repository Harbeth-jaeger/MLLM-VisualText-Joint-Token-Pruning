# Copy this file to .env and replace each value with the path on this machine.
MLLM_PRUNE_ENV_PATH=/path/to/envs/mllm_prune
MILEBENCH_ROOT=/path/to/datasets/mllm_prune/milebench
MMCOQA_ANNOTATION_PATH=/path/to/datasets/mllm_prune/milebench/raw/MMCoQA/MMCoQA.json
MMCOQA_IMAGE_DIR=/path/to/datasets/mllm_prune/milebench/raw/MMCoQA/images
QWEN_MODEL_PATH=/path/to/models/Qwen2.5-VL-7B-Instruct
MLLM_ATTN_IMPLEMENTATION=flash_attention_2
MMCOQA_SUBSET_PATH=data/interim/experiment_001/mmcoqa_50.json
EXPERIMENT_002_PREDICTIONS_PATH=outputs/experiment_002/results.jsonl
EXPERIMENT_002_SUMMARY_PATH=outputs/experiment_002/summary.json
ALIGNED_ENCODER_PATH=/path/to/models/clip-vit-base-patch16
EXPERIMENT_003_CALIBRATION_SUBSET_PATH=data/interim/experiment_003/mmcoqa_calibration_50.json
EXPERIMENT_003_CALIBRATION_PATH=outputs/experiment_003/calibration.json
EXPERIMENT_003_PREDICTIONS_PATH=outputs/experiment_003/results.jsonl
EXPERIMENT_003_SUMMARY_PATH=outputs/experiment_003/summary.json
EXPERIMENT_004_SPLIT_DIR=data/interim/experiment_004/splits
EXPERIMENT_004_LABEL_DIR=/path/to/runs/mllm_prune/experiment_004/labels
EXPERIMENT_004_CHECKPOINT_DIR=/path/to/runs/mllm_prune/experiment_004/checkpoints
EXPERIMENT_004_PREDICTIONS_PATH=/path/to/runs/mllm_prune/experiment_004/results.jsonl
EXPERIMENT_004_SUMMARY_PATH=outputs/experiment_004/summary.json
EXPERIMENT_005_ALIGNED_CACHE_DIR=/path/to/runs/mllm_prune/experiment_005/aligned_cache
EXPERIMENT_005_LABEL_DIR=/path/to/runs/mllm_prune/experiment_005/labels
EXPERIMENT_005_CHECKPOINT_DIR=/path/to/runs/mllm_prune/experiment_005/checkpoints
EXPERIMENT_005_PREDICTIONS_PATH=/path/to/runs/mllm_prune/experiment_005/results.jsonl
EXPERIMENT_005_SUMMARY_PATH=outputs/experiment_005/summary.json

